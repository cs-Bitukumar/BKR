.ludo-room-status{display:flex;justify-content:flex-start;margin:12px 0 18px}.ludo-status-pill{display:inline-flex;align-items:center;padding:8px 12px;border-radius:999px;border:1px solid rgba(106,255,129,.25);background:rgba(16,103,33,.2);color:var(--primary);font-size:.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}.ludo-status-pill.is-ready{background:linear-gradient(135deg,rgba(40,255,134,.2),rgba(18,98,52,.25));box-shadow:0 0 24px rgba(40,255,134,.15)}.ludo-room-panel--waiting{position:relative;overflow:hidden}.ludo-room-panel--waiting::before{content:'';position:absolute;inset:0;background:linear-gradient(120deg,rgba(70,255,116,.06),transparent 40%,rgba(70,255,116,.03));pointer-events:none}.ludo-transition-banner{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 14px;padding:10px 14px;border:1px solid rgba(120,255,168,.28);border-radius:12px;background:linear-gradient(135deg,rgba(40,255,134,.16),rgba(10,72,34,.12));color:var(--primary)}.ludo-transition-badge{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;background:rgba(255,255,255,.12);font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.ludo-live-transition{animation:ludoBoardReveal .45s ease-out}.ludo-live-board-shell{border:1px solid rgba(122,255,180,.26);box-shadow:0 0 0 1px rgba(122,255,180,.12),0 28px 60px rgba(0,0,0,.36)}@keyframes ludoBoardReveal{0%{opacity:.2;transform:translateY(12px) scale(.985)}100%{opacity:1;transform:translateY(0) scale(1)}}